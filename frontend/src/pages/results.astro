<script is:inline>
  (function () {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const views = document.querySelectorAll('.explorer-view');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetView = btn.getAttribute('data-view');

        // Tab buttons styling
        tabBtns.forEach(b => {
          b.className = 'tab-btn px-3 py-1.5 rounded-full transition-all text-apple-gray-500 hover:text-apple-gray-900 dark:hover:text-white';
        });
        btn.className = 'tab-btn px-3 py-1.5 rounded-full transition-all bg-apple-gray-900 dark:bg-white text-white dark:text-apple-gray-900';

        // Switch views
        views.forEach(v => {
          if (v.id === targetView) {
            v.classList.remove('hidden');
          } else {
            v.classList.add('hidden');
          }
        });
      });
    });

    // Check URL hash on load
    if (window.location.hash) {
      const hash = window.location.hash.replace('#', '');
      if (hash === 'goodhart') {
        const btn = document.querySelector('[data-view="view-goodhart"]');
        if (btn) btn.click();
      } else if (hash === 'compute-frontier') {
        const btn = document.querySelector('[data-view="view-compute"]');
        if (btn) btn.click();
      } else if (hash.startsWith('claim')) {
        const btn = document.querySelector('[data-view="view-claims"]');
        if (btn) btn.click();
      }
    }

    // Claim Filter buttons
    const filterBtns = document.querySelectorAll('.claim-filter-btn');
    const claimCards = document.querySelectorAll('.claim-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        filterBtns.forEach(b => {
          b.className = 'claim-filter-btn px-2.5 py-1 rounded-full text-xs font-semibold bg-apple-gray-100 dark:bg-apple-gray-800 text-apple-gray-600 dark:text-apple-gray-300';
        });
        btn.className = 'claim-filter-btn px-2.5 py-1 rounded-full text-xs font-semibold bg-apple-gray-900 dark:bg-white text-white dark:text-apple-gray-900';

        claimCards.forEach(card => {
          const status = card.getAttribute('data-status');
          if (filter === 'all' || status === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  })();
</script>
