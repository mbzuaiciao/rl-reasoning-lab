---
// docs/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { DOCS_METADATA, getDocMarkdown } from '../../lib/data';
import { processMarkdown } from '../../lib/markdown';

export async function getStaticPaths() {
  const paths = [];

  for (let i = 0; i < DOCS_METADATA.length; i++) {
    const doc = DOCS_METADATA[i];
    const raw = getDocMarkdown(doc.slug);
    const processed = await processMarkdown(raw);

    const prev = i > 0 ? DOCS_METADATA[i - 1] : null;
    const next = i < DOCS_METADATA.length - 1 ? DOCS_METADATA[i + 1] : null;

    paths.push({
      params: { slug: doc.slug },
      props: {
        doc,
        processed,
        prev,
        next
      }
    });
  }

  return paths;
}

const { doc, processed, prev, next } = Astro.props;
---

<BaseLayout
  title={`${doc.title} | RL Reasoning Lab`}
  description={doc.subtitle}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <!-- Breadcrumb & Top Bar -->
    <div class="flex items-center justify-between pb-6 mb-8 border-b border-black/[0.06] dark:border-white/[0.08] text-xs">
      <div class="flex items-center gap-2 text-apple-gray-500 dark:text-apple-gray-400">
        <a href="/docs" class="hover:text-apple-blue transition-colors">Research Docs</a>
        <span>/</span>
        <span class="text-apple-gray-800 dark:text-apple-gray-200 font-medium uppercase text-[10px] tracking-wider px-2 py-0.5 rounded-full bg-apple-gray-200 dark:bg-apple-gray-800">
          {doc.category}
        </span>
      </div>
      <div class="flex items-center gap-4 text-[11px] text-apple-gray-400">
        <span>~{doc.readingTimeMinutes} min read</span>
        <a
          href={`https://github.com/mbzuaiciao/rl-reasoning-lab/blob/main/${doc.filePath}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-apple-blue transition-colors flex items-center gap-1 font-medium"
        >
          View Source ↗
        </a>
      </div>
    </div>

    <!-- Main Content Layout with Sticky Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 xl:gap-14">
      <!-- Article Column (Left 8 cols, max-w-3xl reading measure) -->
      <article class="lg:col-span-8 xl:col-span-8 min-w-0">
        <!-- Rendered Prose HTML with KaTeX and Shiki -->
        <div class="prose-lab mx-auto lg:mx-0" set:html={processed.html} />

        <!-- Bottom Navigation Controls -->
        <div class="mt-16 pt-8 border-t border-black/[0.06] dark:border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-4">
          {prev ? (
            <a
              href={`/docs/${prev.slug}`}
              class="w-full sm:w-auto p-4 rounded-2xl border border-black/[0.06] dark:border-white/[0.08] hover:border-black/[0.14] dark:hover:border-white/[0.16] bg-white dark:bg-apple-gray-900 shadow-subtle hover:shadow-card transition-all text-left flex-1"
            >
              <span class="text-[10px] uppercase font-semibold text-apple-gray-400 tracking-wider block mb-1">
                ← Previous Document
              </span>
              <span class="text-xs font-bold text-apple-gray-900 dark:text-white line-clamp-1">
                {prev.title}
              </span>
            </a>
          ) : <div class="hidden sm:block flex-1" />}

          {next ? (
            <a
              href={`/docs/${next.slug}`}
              class="w-full sm:w-auto p-4 rounded-2xl border border-black/[0.06] dark:border-white/[0.08] hover:border-black/[0.14] dark:hover:border-white/[0.16] bg-white dark:bg-apple-gray-900 shadow-subtle hover:shadow-card transition-all text-right flex-1"
            >
              <span class="text-[10px] uppercase font-semibold text-apple-gray-400 tracking-wider block mb-1">
                Next Document →
              </span>
              <span class="text-xs font-bold text-apple-gray-900 dark:text-white line-clamp-1">
                {next.title}
              </span>
            </a>
          ) : <div class="hidden sm:block flex-1" />}
        </div>
      </article>

      <!-- Sidebar Column (Right 4 cols, sticky) -->
      <aside class="hidden lg:block lg:col-span-4 xl:col-span-4">
        <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto space-y-6 pr-2">
          <!-- Meta Card -->
          <div class="p-4 rounded-2xl bg-apple-gray-100/70 dark:bg-apple-gray-900/60 border border-black/[0.04] dark:border-white/[0.06] text-xs space-y-2 shadow-subtle">
            <div class="font-semibold text-apple-gray-900 dark:text-apple-gray-100">
              {doc.title}
            </div>
            <p class="text-[11px] text-apple-gray-500 dark:text-apple-gray-400 leading-relaxed">
              {doc.subtitle}
            </p>
          </div>

          <!-- Table of Contents -->
          <TableOfContents toc={processed.toc} />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
