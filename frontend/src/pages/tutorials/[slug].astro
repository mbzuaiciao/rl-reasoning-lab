---
// tutorials/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { TUTORIALS_METADATA, getTutorialMarkdown } from '../../lib/data';
import { processMarkdown } from '../../lib/markdown';

export async function getStaticPaths() {
  const paths = [];

  for (let i = 0; i < TUTORIALS_METADATA.length; i++) {
    const tut = TUTORIALS_METADATA[i];
    const raw = getTutorialMarkdown(tut.slug);
    const processed = await processMarkdown(raw);

    const prev = i > 0 ? TUTORIALS_METADATA[i - 1] : null;
    const next = i < TUTORIALS_METADATA.length - 1 ? TUTORIALS_METADATA[i + 1] : null;

    paths.push({
      params: { slug: tut.slug },
      props: {
        tut,
        processed,
        prev,
        next
      }
    });
  }

  return paths;
}

const { tut, processed, prev, next } = Astro.props;
---

<BaseLayout
  title={`${tut.title} | RL Reasoning Lab`}
  description={tut.description}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <!-- Breadcrumb & Top Bar -->
    <div class="flex items-center justify-between pb-6 mb-8 border-b border-black/[0.06] dark:border-white/[0.08] text-xs">
      <div class="flex items-center gap-2 text-apple-gray-500 dark:text-apple-gray-400">
        <a href="/tutorials" class="hover:text-apple-blue transition-colors">Curriculum</a>
        <span>/</span>
        <span class="text-apple-gray-800 dark:text-apple-gray-200 font-medium">Phase {tut.phase}</span>
      </div>
      <div class="flex items-center gap-4 text-[11px] text-apple-gray-400">
        <span>~{tut.readingTimeMinutes} min read</span>
        <a
          href={`https://github.com/mbzuaiciao/rl-reasoning-lab/blob/main/${tut.filePath}`}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-apple-blue transition-colors flex items-center gap-1"
        >
          View Source ↗
        </a>
      </div>
    </div>

    <!-- Main Content Layout with Sticky Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Article Column (Left 8-9 cols) -->
      <article class="lg:col-span-8 xl:col-span-9 min-w-0">
        <!-- Rendered Prose HTML with KaTeX and Shiki -->
        <div class="prose-lab max-w-none" set:html={processed.html} />

        <!-- Bottom Navigation Controls -->
        <div class="mt-16 pt-8 border-t border-black/[0.08] dark:border-white/[0.1] flex flex-col sm:flex-row items-center justify-between gap-4">
          {prev ? (
            <a
              href={`/tutorials/${prev.slug}`}
              class="w-full sm:w-auto p-4 rounded-xl border border-black/[0.06] dark:border-white/[0.08] hover:border-apple-blue/30 dark:hover:border-apple-blue-dark/40 bg-white dark:bg-apple-gray-900 transition-all text-left flex-1"
            >
              <span class="text-[10px] uppercase font-semibold text-apple-gray-400 tracking-wider block mb-1">
                ← Previous Phase {prev.phase}
              </span>
              <span class="text-xs font-bold text-apple-gray-900 dark:text-white line-clamp-1">
                {prev.title}
              </span>
            </a>
          ) : <div class="hidden sm:block flex-1" />}

          {next ? (
            <a
              href={`/tutorials/${next.slug}`}
              class="w-full sm:w-auto p-4 rounded-xl border border-black/[0.06] dark:border-white/[0.08] hover:border-apple-blue/30 dark:hover:border-apple-blue-dark/40 bg-white dark:bg-apple-gray-900 transition-all text-right flex-1"
            >
              <span class="text-[10px] uppercase font-semibold text-apple-gray-400 tracking-wider block mb-1">
                Next Phase {next.phase} →
              </span>
              <span class="text-xs font-bold text-apple-gray-900 dark:text-white line-clamp-1">
                {next.title}
              </span>
            </a>
          ) : (
            <a
              href="/docs/phase10_capstone_report"
              class="w-full sm:w-auto p-4 rounded-xl border border-apple-purple/30 bg-apple-purple/5 dark:bg-apple-purple-dark/10 transition-all text-right flex-1"
            >
              <span class="text-[10px] uppercase font-semibold text-apple-purple dark:text-apple-purple-dark tracking-wider block mb-1">
                Capstone Benchmark →
              </span>
              <span class="text-xs font-bold text-apple-gray-900 dark:text-white line-clamp-1">
                Phase 10 Capstone Report
              </span>
            </a>
          )}
        </div>
      </article>

      <!-- Sidebar Column (Right 4-3 cols, sticky) -->
      <aside class="hidden lg:block lg:col-span-4 xl:col-span-3">
        <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto space-y-6 pr-2">
          <!-- Meta Card -->
          <div class="p-4 rounded-2xl bg-apple-gray-100/60 dark:bg-apple-gray-900/60 border border-black/[0.04] dark:border-white/[0.06] text-xs space-y-2">
            <div class="font-semibold text-apple-gray-800 dark:text-apple-gray-200">
              Phase {tut.phase} Overview
            </div>
            <p class="text-[11px] text-apple-gray-500 dark:text-apple-gray-400 leading-relaxed">
              {tut.subtitle}
            </p>
          </div>

          <!-- Table of Contents -->
          <TableOfContents toc={processed.toc} />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
