---
// MetricCard.astro
interface Props {
  value: string;
  label: string;
  sublabel?: string;
  badge?: string;
  ci?: string;
  cohensD?: string;
  claimId?: string;
  variant?: 'blue' | 'green' | 'red' | 'purple' | 'neutral';
}

const {
  value,
  label,
  sublabel,
  badge,
  ci,
  cohensD,
  claimId,
  variant = 'neutral'
} = Astro.props;

const badgeStyles = {
  blue: 'bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/15 dark:text-apple-blue-dark',
  green: 'bg-apple-green/10 text-apple-green dark:bg-apple-green-dark/15 dark:text-apple-green-dark',
  red: 'bg-apple-red/10 text-apple-red dark:bg-apple-red-dark/15 dark:text-apple-red-dark',
  purple: 'bg-apple-purple/10 text-apple-purple dark:bg-apple-purple-dark/15 dark:text-apple-purple-dark',
  neutral: 'bg-black/5 dark:bg-white/10 text-apple-gray-600 dark:text-apple-gray-300'
};

const valueColors = {
  blue: 'text-apple-blue dark:text-apple-blue-dark',
  green: 'text-apple-green dark:text-apple-green-dark',
  red: 'text-apple-red dark:text-apple-red-dark',
  purple: 'text-apple-purple dark:text-apple-purple-dark',
  neutral: 'text-apple-gray-900 dark:text-white'
};
---

<div class="rounded-2xl p-5 bg-white dark:bg-apple-gray-900/90 border border-black/[0.06] dark:border-white/[0.08] shadow-subtle hover:shadow-card hover:border-black/[0.12] dark:hover:border-white/[0.16] transition-all duration-200 flex flex-col justify-between">
  <div>
    <div class="flex items-center justify-between mb-2 gap-2">
      <span class="text-xs font-medium text-apple-gray-500 dark:text-apple-gray-400 truncate">
        {label}
      </span>
      {badge && (
        <span class={`text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full whitespace-nowrap shrink-0 ${badgeStyles[variant]}`}>
          {badge}
        </span>
      )}
    </div>
    <div class={`text-2xl sm:text-3xl font-bold tracking-tight ${valueColors[variant]} mb-1.5 font-mono tabular-nums`}>
      {value}
    </div>
    {sublabel && (
      <p class="text-xs text-apple-gray-500 dark:text-apple-gray-400 leading-relaxed">
        {sublabel}
      </p>
    )}
  </div>

  {(ci || cohensD || claimId) && (
    <div class="mt-4 pt-3 border-t border-black/[0.04] dark:border-white/[0.06] flex items-center justify-between text-[11px] text-apple-gray-400 dark:text-apple-gray-500 font-mono">
      <div class="truncate">
        {cohensD && <span class="mr-2">d = {cohensD}</span>}
        {ci && <span>{ci}</span>}
      </div>
      {claimId && (
        <a
          href={`/docs/claims#${claimId.toLowerCase()}`}
          class="shrink-0 ml-2 font-sans font-medium text-apple-blue dark:text-apple-blue-dark hover:underline"
        >
          {claimId} →
        </a>
      )}
    </div>
  )}
</div>
