---
// SearchModal.astro
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden items-start justify-center pt-16 sm:pt-24 px-4 bg-black/40 dark:bg-black/70 backdrop-blur-sm transition-opacity"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-modal-title"
>
  <div
    class="w-full max-w-xl bg-white dark:bg-apple-gray-900 rounded-2xl shadow-elevated border border-black/[0.08] dark:border-white/[0.12] overflow-hidden flex flex-col max-h-[80vh] animate-in fade-in zoom-in-95 duration-150"
  >
    <!-- Search Input Header -->
    <div class="flex items-center px-4 py-3 border-b border-black/[0.06] dark:border-white/[0.08]">
      <svg class="w-5 h-5 text-apple-gray-400 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        id="search-input"
        placeholder="Search tutorials, research claims, findings, demos..."
        class="w-full bg-transparent text-sm sm:text-base text-apple-gray-900 dark:text-white placeholder-apple-gray-400 focus:outline-none"
        autocomplete="off"
        spellcheck="false"
      />
      <button
        type="button"
        id="search-close-btn"
        class="ml-2 text-xs text-apple-gray-400 hover:text-apple-gray-600 dark:hover:text-apple-gray-200 px-2 py-1 rounded bg-black/5 dark:bg-white/10"
      >
        ESC
      </button>
    </div>

    <!-- Results List -->
    <div id="search-results" class="overflow-y-auto p-2 space-y-1 divide-y divide-black/[0.03] dark:divide-white/[0.04]">
      <div id="search-placeholder" class="py-12 text-center text-xs text-apple-gray-400">
        Type to search across 9 tutorials, 10 research docs, and 16 empirical claims.
      </div>
    </div>

    <!-- Modal Footer Shortcuts -->
    <div class="px-4 py-2 border-t border-black/[0.06] dark:border-white/[0.08] bg-apple-gray-50/50 dark:bg-apple-gray-950/50 text-[11px] text-apple-gray-400 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span><kbd class="font-mono bg-black/5 dark:bg-white/10 px-1 py-0.5 rounded">↑</kbd> <kbd class="font-mono bg-black/5 dark:bg-white/10 px-1 py-0.5 rounded">↓</kbd> to navigate</span>
        <span><kbd class="font-mono bg-black/5 dark:bg-white/10 px-1 py-0.5 rounded">↵</kbd> to open</span>
      </div>
      <span><kbd class="font-mono bg-black/5 dark:bg-white/10 px-1 py-0.5 rounded">esc</kbd> to dismiss</span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input');
    const resultsContainer = document.getElementById('search-results');
    const closeBtn = document.getElementById('search-close-btn');
    const triggerBtn = document.getElementById('search-trigger-btn');

    let searchData = null;
    let selectedIndex = -1;

    async function loadData() {
      if (!searchData) {
        try {
          const res = await fetch('/api/search.json');
          searchData = await res.json();
        } catch (e) {
          console.error('Failed to load search index:', e);
          searchData = [];
        }
      }
    }

    function openModal() {
      if (!modal) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      loadData();
      setTimeout(() => input && input.focus(), 50);
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      if (input) input.value = '';
      renderPlaceholder();
    }

    function renderPlaceholder(msg = 'Type to search across 9 tutorials, 10 research docs, and 16 empirical claims.') {
      if (!resultsContainer) return;
      resultsContainer.innerHTML = `<div class="py-12 text-center text-xs text-apple-gray-400">${msg}</div>`;
      selectedIndex = -1;
    }

    function performSearch(query) {
      if (!query || query.trim().length === 0) {
        renderPlaceholder();
        return;
      }
      if (!searchData) return;

      const q = query.toLowerCase().trim();
      const terms = q.split(/\s+/);

      const matches = searchData.filter(item => {
        const text = `${item.title} ${item.subtitle} ${(item.keywords || []).join(' ')}`.toLowerCase();
        return terms.every(term => text.includes(term));
      });

      if (matches.length === 0) {
        renderPlaceholder('No results found for "' + query + '".');
        return;
      }

      selectedIndex = 0;
      resultsContainer.innerHTML = matches.slice(0, 15).map((item, idx) => {
        let badgeColor = 'bg-apple-gray-200 text-apple-gray-700 dark:bg-apple-gray-800 dark:text-apple-gray-300';
        if (item.type === 'tutorial') badgeColor = 'bg-apple-blue/10 text-apple-blue dark:bg-apple-blue-dark/15 dark:text-apple-blue-dark';
        if (item.type === 'claim') badgeColor = 'bg-apple-green/10 text-apple-green dark:bg-apple-green-dark/15 dark:text-apple-green-dark';
        if (item.type === 'finding') badgeColor = 'bg-apple-purple/10 text-apple-purple dark:bg-apple-purple-dark/15 dark:text-apple-purple-dark';

        return `
          <a
            href="${item.url}"
            data-index="${idx}"
            class="search-item flex items-center justify-between p-2.5 rounded-xl text-left transition-colors ${idx === 0 ? 'bg-apple-blue/10 dark:bg-apple-blue-dark/15' : 'hover:bg-black/5 dark:hover:bg-white/5'}"
          >
            <div class="flex-1 min-w-0 pr-3">
              <div class="flex items-center gap-2 mb-0.5">
                <span class="text-[10px] font-semibold tracking-wider uppercase px-2 py-0.5 rounded-full whitespace-nowrap shrink-0 ${badgeColor}">
                  ${item.badge || item.type}
                </span>
                <span class="text-xs font-semibold text-apple-gray-900 dark:text-white truncate">
                  ${item.title}
                </span>
              </div>
              <p class="text-[11px] text-apple-gray-500 dark:text-apple-gray-400 truncate">
                ${item.subtitle}
              </p>
            </div>
            <svg class="w-3.5 h-3.5 text-apple-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        `;
      }).join('');
    }

    function updateSelection() {
      const items = resultsContainer.querySelectorAll('.search-item');
      items.forEach((item, idx) => {
        if (idx === selectedIndex) {
          item.classList.add('bg-apple-blue/10', 'dark:bg-apple-blue-dark/15');
          item.scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('bg-apple-blue/10', 'dark:bg-apple-blue-dark/15');
        }
      });
    }

    // Event listeners
    if (triggerBtn) triggerBtn.addEventListener('click', openModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    input.addEventListener('input', (e) => {
      performSearch(e.target.value);
    });

    input.addEventListener('keydown', (e) => {
      const items = resultsContainer.querySelectorAll('.search-item');
      if (items.length === 0) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = (selectedIndex + 1) % items.length;
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = (selectedIndex - 1 + items.length) % items.length;
        updateSelection();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (items[selectedIndex]) {
          window.location.href = items[selectedIndex].getAttribute('href');
        }
      }
    });

    window.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (modal.classList.contains('hidden')) {
          openModal();
        } else {
          closeModal();
        }
      } else if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeModal();
      }
    });
  })();
</script>
