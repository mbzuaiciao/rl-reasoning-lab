---
// Header.astro
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navLinks = [
  { href: '/', label: 'Overview' },
  { href: '/tutorials', label: 'Curriculum' },
  { href: '/docs', label: 'Research Docs' },
  { href: '/results', label: 'Results Explorer' },
  { href: '/demos', label: 'Demos' }
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath.startsWith(href);
};
---

<header class="sticky top-0 z-40 w-full backdrop-blur-xl bg-apple-gray-50/80 dark:bg-black/80 border-b border-black/[0.06] dark:border-white/[0.1] transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-13 py-2">
      <!-- Logo / Title -->
      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-7 h-7 rounded-lg bg-apple-gray-800 dark:bg-white text-white dark:text-apple-gray-900 flex items-center justify-center font-mono font-bold text-xs tracking-tight shadow-sm transition-transform group-hover:scale-105">
          RL
        </div>
        <div class="flex flex-col">
          <span class="text-sm font-semibold tracking-tight text-apple-gray-800 dark:text-apple-gray-100 group-hover:text-apple-blue dark:group-hover:text-apple-blue-dark transition-colors">
            rl-reasoning-lab
          </span>
          <span class="text-[10px] text-apple-gray-400 dark:text-apple-gray-500 leading-none">
            Empirical RL Curriculum & Capstone
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1">
        {navLinks.map(link => {
          const active = isActive(link.href);
          return (
            <a
              href={link.href}
              class={`px-3 py-1.5 rounded-full text-xs font-medium transition-all ${
                active
                  ? 'bg-apple-gray-200/70 dark:bg-apple-gray-800 text-apple-gray-900 dark:text-white font-semibold shadow-xs'
                  : 'text-apple-gray-500 dark:text-apple-gray-400 hover:text-apple-gray-900 dark:hover:text-white hover:bg-black/5 dark:hover:bg-white/5'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Right Actions: Search, Theme Toggle, GitHub, Mobile Menu -->
      <div class="flex items-center gap-2">
        <!-- Search Trigger Button -->
        <button
          type="button"
          id="search-trigger-btn"
          class="flex items-center gap-2 px-2.5 py-1.5 rounded-full text-xs font-normal text-apple-gray-500 dark:text-apple-gray-400 bg-apple-gray-100 dark:bg-apple-gray-900/90 border border-black/[0.06] dark:border-white/[0.08] hover:border-black/15 dark:hover:border-white/20 transition-all shadow-xs"
          aria-label="Search tutorials and research"
        >
          <svg class="w-3.5 h-3.5 text-apple-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden sm:inline">Search</span>
          <kbd class="hidden sm:inline-flex items-center px-1.5 py-0.5 text-[10px] font-mono text-apple-gray-400 bg-black/5 dark:bg-white/10 rounded">
            ⌘K
          </kbd>
        </button>

        <!-- Theme Toggle -->
        <ThemeToggle />

        <!-- GitHub Repo Link -->
        <a
          href="https://github.com/mbzuaiciao/rl-reasoning-lab"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center w-9 h-9 rounded-full text-apple-gray-500 dark:text-apple-gray-400 hover:text-apple-gray-800 dark:hover:text-apple-gray-100 hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
          aria-label="GitHub Repository"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="md:hidden inline-flex items-center justify-center w-9 h-9 rounded-full text-apple-gray-500 hover:text-apple-gray-800 dark:hover:text-white"
          aria-label="Open navigation menu"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-4 space-y-1 bg-apple-gray-50/95 dark:bg-apple-gray-900/95 border-b border-black/[0.08] dark:border-white/[0.1] backdrop-blur-xl">
    {navLinks.map(link => {
      const active = isActive(link.href);
      return (
        <a
          href={link.href}
          class={`block px-3 py-2 rounded-xl text-sm font-medium transition-colors ${
            active
              ? 'bg-apple-gray-200 dark:bg-apple-gray-800 text-apple-gray-900 dark:text-white font-semibold'
              : 'text-apple-gray-600 dark:text-apple-gray-300 hover:bg-black/5 dark:hover:bg-white/5'
          }`}
        >
          {link.label}
        </a>
      );
    })}
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;

    btn.addEventListener('click', () => {
      const isOpen = !menu.classList.contains('hidden');
      if (isOpen) {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      } else {
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  })();
</script>
