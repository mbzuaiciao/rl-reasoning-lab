---
// TableOfContents.astro
import type { TableOfContentsItem } from '../lib/types';

interface Props {
  toc: TableOfContentsItem[];
}

const { toc } = Astro.props;
---

{toc.length > 0 && (
  <nav class="space-y-1 text-xs" aria-label="Table of Contents">
    <p class="font-semibold text-apple-gray-800 dark:text-apple-gray-200 uppercase tracking-wider text-[11px] mb-3">
      On this page
    </p>
    <ul class="space-y-1.5 border-l border-black/[0.08] dark:border-white/[0.1] pl-3">
      {toc.map(item => (
        <li class={item.depth === 3 ? 'ml-3' : ''}>
          <a
            href={`#${item.id}`}
            class="toc-link block py-0.5 text-apple-gray-500 dark:text-apple-gray-400 hover:text-apple-blue dark:hover:text-apple-blue-dark transition-colors line-clamp-1"
            data-target={item.id}
          >
            {item.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script is:inline>
  (function () {
    const links = document.querySelectorAll('.toc-link');
    if (links.length === 0) return;

    const headingMap = new Map();
    links.forEach(link => {
      const id = link.getAttribute('data-target');
      if (id) {
        const el = document.getElementById(id);
        if (el) headingMap.set(el, link);
      }
    });

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const activeLink = headingMap.get(entry.target);
          if (activeLink) {
            links.forEach(l => {
              l.classList.remove('text-apple-blue', 'dark:text-apple-blue-dark', 'font-semibold');
              l.classList.add('text-apple-gray-500', 'dark:text-apple-gray-400');
            });
            activeLink.classList.remove('text-apple-gray-500', 'dark:text-apple-gray-400');
            activeLink.classList.add('text-apple-blue', 'dark:text-apple-blue-dark', 'font-semibold');
          }
        }
      });
    }, {
      rootMargin: '-80px 0px -70% 0px'
    });

    headingMap.forEach((_, headingEl) => {
      observer.observe(headingEl);
    });
  })();
</script>
